{
  "name": "angular-doctor",
  "version": "1.3.0",
  "author": "Antony Giomar <antonygiomarx@gmail.com>",
  "description": "Diagnose and fix issues in your Angular app",
  "repository": {
    "url": "https://github.com/antonygiomarxdev/angular-doctor"
  },
  "keywords": [
    "angular",
    "diagnostics",
    "linter",
    "performance"
  ],
  "license": "MIT",
  "bin": "bin/angular-doctor.js",
  "files": [
    "dist",
    "bin",
    "skills",
    "install-skill.sh"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./api": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rimraf dist && tsdown",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular-eslint/utils": "^21.4.0",
    "commander": "^14.0.3",
    "eslint": "^9.39.2",
    "jscpd": "^4.1.1",
    "knip": "^5.84.1",
    "madge": "^8.0.0",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "stylelint": "^17.11.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.1.1",
    "ts-morph": "^28.0.0",
    "typescript": ">=5.0.4 <6",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@types/madge": "^5.0.3",
    "@types/prompts": "^2.4.9",
    "rimraf": "^6.0.1",
    "tsdown": "^0.20.3",
    "vitest": "^4.0.18"
  }
}
